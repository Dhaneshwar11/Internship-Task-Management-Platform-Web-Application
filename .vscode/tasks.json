{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Vite dev server",
            "type": "shell",
            "command": "npm.cmd run dev",
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "^(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^> .* dev$",
                    "endsPattern": "Local:.*http://localhost:8080"
                }
            }
        }
    ]
}